# Copy to .env and fill in real values for your environment.
# Values here are illustrative only -- never commit real secrets.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agrimind_dev

# Generate a real random secret for any non-local environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-real-random-secret-in-production

CORS_ORIGINS=["http://localhost:3000"]

# mock | real -- real requires a wired-up model/provider (see app/ai/factory.py)
AI_MODE=mock
WEATHER_PROVIDER=mock

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_SIZE_MB=8

# AI Farm Copilot -- decoupled from AI_MODE above, mock | real
COPILOT_PROVIDER=mock
# Only read when COPILOT_PROVIDER=real. Leave empty for mock mode.
# NEVER commit a real key -- set this in your local, untracked .env only.
COPILOT_LLM_API_KEY=
COPILOT_LLM_MODEL_NAME=
